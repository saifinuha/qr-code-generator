{
  "name": "qr-studio",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "web": "npx serve ./",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.saifinuha.qrstudio",
    "productName": "QR Studio",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {"target":"nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {"target":"zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        {"target":"AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {"target":"deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [],
  "author": {
    "name": "saifinuha",
    "email": "79562533+saifinuha@users.noreply.github.com"
  },
  "license": "ISC",
  "description": "QR Studio is a free and open-source desktop application for generating high-quality QR codes.",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "qr-code-styling": "^1.6.0-rc.1"
  }
}
